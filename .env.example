# Cooper Chat server URL
COOPER_CHAT_URL=https://chat.garrity.org:8443

# Family secret for authentication
FAMILY_SECRET=ReadingAndWriting

# Bot's display name in Cooper Chat (registers with is_bot=true)
BOT_USERNAME=WeatherBot

# Recipient's display name (must be an existing Cooper Chat user)
RECIPIENT_NAME=Cooper

# Location for weather forecast (city, state or city, country)
WEATHER_LOCATION=Sonora, CA

# OpenAI API key (required for interactive mode)
OPENAI_API_KEY=
